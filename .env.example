# Copy this file to .env and fill in your real values.
# .env is gitignored -- never commit real secrets.

# Find this in your Sleeper league URL: sleeper.app/leagues/<LEAGUE_ID>/...
SLEEPER_LEAGUE_ID=

# Discord server -> channel settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

TIMEZONE=America/New_York
# START_DATE=2026-09-10
# END_DATE=2027-01-10
# CLOSE_SCORES_THRESHOLD=15
# DAILY_WAIVER=false
# INIT_MSG=SleeperBot is online!

# Optional: enables live slash commands (/standings, /matchups, etc). See the
# README's "Enabling slash commands" section for how to get these from the
# Discord Developer Portal. Leave both unset to keep webhook-only behavior.
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
